# 9Router Server URL (support local, remote VPS, or Cloudflare Tunnel)
# Examples:
#   Local default: http://localhost:20128/v1
#   Remote IP    : http://123.45.67.89:20128/v1
#   CF Tunnel    : https://ai.yourdomain.com/v1
ROUTER_URL=http://localhost:20128/v1

# 9Router API Key (default is often 9router or your custom key)
API_KEY=9router

# Target Model to Benchmark
# Examples: claude-3-5-sonnet, gpt-4o, gemini-2.0-flash, deepseek-chat
DEFAULT_MODEL=claude-3-5-sonnet

# Benchmark Configuration
DEFAULT_BURST=15
DEFAULT_CONCURRENCY=5
DEFAULT_MODE=rpm
